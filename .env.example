# Copy to .env.local (local) or set in your hosting provider. Never commit real values.

# Production origin of this landing page (used for canonical URL, OG tags, sitemap).
NEXT_PUBLIC_SITE_URL=https://mbatravelsgoa.com
# Set to "false" to add noindex (e.g. a staging URL or an ads-only subdomain).
NEXT_PUBLIC_ALLOW_INDEXING=true

# ---- Enquiry delivery (server-only; configure at least one) ----
# Any HTTPS endpoint that accepts a JSON POST: Google Apps Script web app, Zapier/Make webhook, CRM.
ENQUIRY_WEBHOOK_URL=
# Optional shared secret sent as the X-Webhook-Secret header.
ENQUIRY_WEBHOOK_SECRET=
# Optional e-mail notifications via Resend (https://resend.com).
RESEND_API_KEY=
ENQUIRY_EMAIL_TO=mbatravels12@gmail.com
# Must be a sender on a domain verified in Resend, e.g. "MBA Travels Goa <bookings@mbatravelsgoa.com>".
ENQUIRY_EMAIL_FROM=

# ---- Tracking (public) ----
# Preferred: Google Tag Manager container, e.g. GTM-XXXXXXX. When set, GA4/Ads tags live inside GTM.
NEXT_PUBLIC_GTM_ID=
# Fallback only when NEXT_PUBLIC_GTM_ID is empty:
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GADS_ID=
NEXT_PUBLIC_GADS_LEAD_LABEL=
NEXT_PUBLIC_GADS_CALL_LABEL=
NEXT_PUBLIC_GADS_WHATSAPP_LABEL=
# "granted" (default) or "denied". "denied" shows a consent banner and waits for a choice.
NEXT_PUBLIC_CONSENT_DEFAULT=granted
